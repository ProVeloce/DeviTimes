# Supply the real password locally; do not commit .env files.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.bzasmtivzauzcudtibyz.supabase.co:5432/postgres?sslmode=verify-full
# Optional absolute path to the CA certificate downloaded from the Supabase dashboard.
SUPABASE_SSL_ROOT_CERT=
# Local development only: leave blank if pg_dump is on PATH.
# Windows example after installing PostgreSQL 18: "C:\Program Files\PostgreSQL\18\bin\pg_dump.exe"
# The Vercel container provides pg_dump automatically; do not use a Windows path there.
PG_DUMP_PATH=
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
SETUP_KEY=replace-with-a-random-setup-key
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Restrict Google-based app login to this existing admin account.
GOOGLE_LOGIN_ALLOWED_EMAIL=shreyanofficial25@gmail.com
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# Keep this stable and private; changing it makes existing MFA secrets unreadable.
MFA_ENCRYPTION_KEY=
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,app://-
